# Copy to .env and fill in. Never commit .env.
# Names and purpose only - the repository contains no real values.

# --- Model provider (optional) -------------------------------------------
# Leave LLM_API_KEY empty to run the deterministic offline extractive fallback.
# Any OpenAI-compatible /chat/completions endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_TIMEOUT_S=20
# Set true in production so the process refuses to boot without a key.
REQUIRE_LLM_KEY=false

# --- Cost control ---------------------------------------------------------
# Price per 1k tokens used for accounting only (USD).
PRICE_INPUT_PER_1K=0.0001
PRICE_OUTPUT_PER_1K=0.0001
# Hard daily cap. Requests get 429 once it is reached.
DAILY_BUDGET_USD=0.50

# --- Serving --------------------------------------------------------------
RATE_LIMIT=5/minute
AGENT_RATE_LIMIT=3/minute
# Behind Railway/HF set true so the X-Forwarded-For client IP is used.
TRUST_PROXY_HEADERS=false
TOP_K=4
MAX_AGENT_STEPS=4

# --- Privacy / logging ----------------------------------------------------
# Salt for the hashed caller id in logs. Set a stable random value in prod.
LOG_SALT=
LOG_DIR=logs
RUNTIME_DIR=data/runtime

# --- MCP ------------------------------------------------------------------
MCP_ENABLED=true
# Optional override, e.g. "/app/.venv/bin/python -m app.mcp_server"
MCP_COMMAND=

# --- UI (Streamlit on Hugging Face Spaces) --------------------------------
API_URL=http://127.0.0.1:8000
